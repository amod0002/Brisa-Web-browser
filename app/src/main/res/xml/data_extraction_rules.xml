<?xml version="1.0" encoding="utf-8"?>
<!-- Brisa no se copia a la nube ni a otro móvil: cookies, sesiones, historial y ajustes se quedan aquí. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" /><exclude domain="file" /><exclude domain="database" />
        <exclude domain="sharedpref" /><exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" /><exclude domain="file" /><exclude domain="database" />
        <exclude domain="sharedpref" /><exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
